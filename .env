# ── Codeforces pipeline ───────────────────────────────────────────────────────
# Problemset filter, Codeforces `tags` query syntax. `3500-` means "rating >= 3500"
# (open-ended range), `1600-1900` means a closed range. Combines with other tags,
# e.g. `3500-+dp`. See https://codeforces.com/problemset/page/1?tags=3500-
AI4CF_TAGS=3500-
# Process at most this many problems per run. 0 = no limit (every page / every
# pending problem). Keep it at 1 until the pipeline looks right.
AI4CF_LIMIT=1
# Parallel workers for downloads and solves. 0 = auto (CPU count), default 1.
AI4CF_JOBS=1
# Failed attempts per problem before it is marked `.failed` and skipped.
AI4CF_MAX_ATTEMPTS=3
# Directory, relative to the project root, that holds the problem workspaces.
AI4CF_PROBLEM_DIR=problem

# ── Network ───────────────────────────────────────────────────────────────────
# Proxy for codeforces.com; empty means a direct connection.
AI4CF_PROXY=
# Seconds to wait between two requests (politeness; CF answers 403 when hammered).
AI4CF_FETCH_DELAY=1.0
AI4CF_FETCH_RETRIES=4
AI4CF_FETCH_TIMEOUT=30
AI4CF_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36

# ── Verification ──────────────────────────────────────────────────────────────
# A sample run is allowed `time limit * AI4CF_TIME_MULT` seconds.
AI4CF_TIME_MULT=3.0
# `make bench` kills the binary after `time limit * AI4CF_BENCH_MULT` seconds;
# its verdict is based on the real limit, the multiplier only bounds the wait.
AI4CF_BENCH_MULT=10.0
# Pull the problem's status page and hand pi a runtime reference (fastest/median
# accepted time, memory, languages) as a performance target. 0 = disabled.
AI4CF_STATUS_REFERENCE=1

# ── pi (deepseek) ─────────────────────────────────────────────────────────────
PI_BIN=pi
PI_MODEL=deepseek/deepseek-flash
PI_THINKING=high
# Wall-clock limit for a single pi attempt, in seconds.
PI_TIMEOUT=3600
# Extra pi flags, space separated (e.g. `--approve`).
PI_EXTRA_ARGS=
